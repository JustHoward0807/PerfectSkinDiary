{
  "expo": {
    "name": "PerfectSkinDiary",
    "slug": "PerfectSkinDiary",
    "scheme": "perfectskindiary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF8F3"
    },
    "ios": {
      "bundleIdentifier": "com.perfectskindiary.app",
      "buildNumber": "2",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "icon": "./assets/PerfectSkinDiary.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "PerfectSkinDiary uses the camera to capture your daily skin selfie for analysis.",
        "NSLocationWhenInUseUsageDescription": "PerfectSkinDiary uses your location to show the current UV index and recommend the right SPF for today.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.perfectskindiary.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF8F3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-font",
      "expo-location",
      "expo-apple-authentication",
      [
        "react-native-iap",
        {
          "playServiceVersion": "20.1.0"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.790615746992-anvu3ivnf4d3apr16au8tcpa3u3ckjas"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c3cbc441-b0b7-4baa-8b47-ab882c51f295"
      }
    },
    "owner": "howardongdev0807"
  }
}
