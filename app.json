{
  "expo": {
    "name": "PerfectSkinDiary",
    "slug": "PerfectSkinDiary",
    "scheme": "perfectskindiary",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF8F3"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/PerfectSkinDiary.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "PerfectSkinDiary uses the camera to capture your daily skin selfie for analysis."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF8F3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera"
    ]
  }
}
