{
  "expo": {
    "name": "PerfectSkinDiary",
    "slug": "PerfectSkinDiary",
    "scheme": "perfectskindiary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF8F3"
    },
    "ios": {
      "bundleIdentifier": "com.perfectskindiary.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "icon": "./assets/PerfectSkinDiary.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "PerfectSkinDiary uses the camera to capture your daily skin selfie for analysis."
      }
    },
    "android": {
      "package": "com.perfectskindiary.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF8F3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c3cbc441-b0b7-4baa-8b47-ab882c51f295"
      }
    },
    "owner": "howardongdev0807"
  }
}
